{
  "name": "tabz",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dist": "pnpm build && zip -r tabz.zip manifest.json config.json options.html options.css dist/",
    "fmt": "biome format --write",
    "pretest": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/chrome": "^0.1.43",
    "@types/node": "^25.9.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.11.2"
}
